# Dokumen internal (PRD, RAB, brand kit, infra) — TIDAK di-push
docs/*
# kecuali dokumentasi teknis untuk AI lintas-tool
!docs/FRONTEND.md
!docs/BACKEND.md

# Raw aset generate (sumber mentah, besar) — simpan lokal saja
/Asset Generate/

# Flutter / Dart
app/build/
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/.pub-cache/
app/.packages
**/.gradle/
**/*.g.dart
**/*.freezed.dart

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.iml
node_modules/

# Graphify local cache & interpreter markers
**/graphify-out/cache/
**/graphify-out/.graphify_*

# Backend runtime & database volume
backend/node_modules/
backend/dist/
backend/.pgdata/
backend/.env

# Binary installer APK (disimpan lokal untuk Google Drive klien)
installer/*.apk
